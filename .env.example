# Qué web es esta. El backend alimenta varias y reparte las notas entre
# ellas: sin este slug la API devolvería también las de la otra.
SITE_SLUG=guayaco

# Base de la API de Django.
# Vacío en desarrollo: vite.config.ts proxea /api a http://127.0.0.1:8000.
# En Cloudflare Pages: https://api.guayashoy.com (misma API para las dos webs).
API_URL=

# Dominio público del sitio. Alimenta canonical, Open Graph y sitemap.
SITE_URL=https://elguayasense.com

# Modo «próximamente»: true tapa la web entera con una portada de espera.
# SOON_KEY es la clave que deja pasar, por formulario o por enlace:
#   https://elguayasense.com/?acceso=eg-cambia-esta-clave
# Viaja en el bundle: sirve para enseñar el sitio a quien tú elijas, no para
# proteger nada. Cambiarla invalida los accesos ya concedidos.
SOON=false
SOON_KEY=eg-cambia-esta-clave
